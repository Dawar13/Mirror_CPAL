# environments
.venv/
__pycache__/
*.pyc
.pytest_cache/

# data, caches and weights (never commit)
cache/
hf/
torch_hub/
*.pth
*.pt
*.safetensors
*.npy
*.npz
*.parquet

# result data: reports and small tables/metadata are kept; operators (npz) and logs stay local
results/*
!results/.gitkeep
!results/*.md
!results/*.csv
!results/*.json
!results/b0_pytest.txt
!results/paper/
!results/paper/**
# new phase (PROJECT_NEXT_PHASE.md, Section 12): one folder per experiment; large arrays and checkpoints stay local
!results/MUST-*/
!results/MUST-*/**
!results/CORE-*/
!results/CORE-*/**
!results/UP-*/
!results/UP-*/**
!results/data_check/
!results/data_check/**
!results/paper_next/
!results/paper_next/**
# final phase (FINAL_PHASE_PLAN.md v2): the pre-registration record and one folder per item (A01 to A15b, A12b);
# large arrays and checkpoints stay local (rules below)
!results/final/
!results/final/**
!results/A0*/
!results/A0*/**
!results/A1*/
!results/A1*/**
results/**/*.npy
results/**/*.npz
results/**/*.pt
# paper handoff (21 November 2026): every array under results/ is kept (predictions, probes, spectra, fit
# sidecars, figure data, the operator structure files; files of 50 MB or more go through Git LFS, see
# .gitattributes), except the rebuildable feature caches of CORE-07 and a duplicate structure file in CORE-05
!results/**/*.npz
!results/**/*.npy
!results/e1_operators.npz
results/CORE-07/features/
results/CORE-05/structure/
tiny_out/
runs/**/*_log.txt

# large artefacts copied from the VM (operators, statistics, checkpoints); the final phase's three Mirror
# checkpoints are kept (Git LFS)
artifacts/*
!artifacts/final_phase/
!artifacts/final_phase/**/*.pt

# local copies of VM logs; the final phase's run logs are kept (runner timeline, GPU log, job logs), except the
# environment log, which names the Hugging Face account
logs/*
!logs/final/
logs/final/w0/env.log
logs/final/w0_env.out

# local smoke-test outputs
runs/t2_seg_smoke/

# paper handoff: the A02 fit inputs (Git LFS) and small run arrays are kept; runs/MUST-09 (previous phase's
# healed states, 2.9 GB) stays local
!runs/x2/**/*.npz
!runs/M7_shards/**
!runs/m1/**
!runs/MUST-10/**
