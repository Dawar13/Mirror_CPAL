\def\@LN@column{1}
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {Mirror Surgery.} (a) Twin neurons respond to mirror images of each other, and their input weights are related by the stream's mirror operator, $w_j = A^\star w_i$. (b) In the eigenbasis of $A^\star $ an equivariant weight matrix is block-diagonal, with an even block and a smaller odd block, so it has $h_+ d_+ + h_- d_-$ instead of $hd$ free parameters. (c) The conversion fits the structure from 2{,}000 images, projects the weights, rewrites them in even and odd coordinates and heals the model; it is exactly equivariant from the projection onwards.}}{2}{figure.1}\protected@file@percent }
\newlabel{fig:method}{{1}{2}{\textbf {Mirror Surgery.} (a) Twin neurons respond to mirror images of each other, and their input weights are related by the stream's mirror operator, $w_j = A^\star w_i$. (b) In the eigenbasis of $A^\star $ an equivariant weight matrix is block-diagonal, with an even block and a smaller odd block, so it has $h_+ d_+ + h_- d_-$ instead of $hd$ free parameters. (c) The conversion fits the structure from 2{,}000 images, projects the weights, rewrites them in even and odd coordinates and heals the model; it is exactly equivariant from the projection onwards}{figure.1}{}}
